{
  "name": "dsh-tuanjie-connect",
  "displayName": "DSH Tuanjie Cowork Connect",
  "description": "将 Tuanjie Cowork (Codely) 桌面 App 中的模型自动接入 DeepSeek Harness — bring Tuanjie Cowork (Codely) app models into DeepSeek Harness with zero configuration.",
  "version": "0.1.6",
  "author": "WuuShan",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "tuanjie",
    "cowork",
    "codely",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "bin": {
    "dsh-tuanjie-connect": "lib/bin.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/protocol.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuuShan/dsh-tuanjie-connect.git"
  },
  "homepage": "https://github.com/WuuShan/dsh-tuanjie-connect#readme",
  "bugs": {
    "url": "https://github.com/WuuShan/dsh-tuanjie-connect/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
